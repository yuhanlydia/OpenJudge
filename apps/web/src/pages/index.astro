---
import Base from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import ScorePlot from '../components/ScorePlot.astro';
import {loadNewsroom,categoryLabels} from '../lib/newsroom';
import {sitePath} from '../lib/basepath';
const articles=loadNewsroom();
const featured=articles[0];
const preview=process.env.NEWSROOM_PREVIEW==='1';
const p=(url:string)=>sitePath(url,import.meta.env.BASE_URL);
const lowCount=articles.filter(article=>article.category==='low-accepted').length;
const highCount=articles.filter(article=>article.category==='high-rejected').length;
---
<Base active="overview">
  <section class="news-edition-line" aria-label="本期专题"><span><i aria-hidden="true"></i>专题 / ICLR 2026</span><span class="edition-description">从评分反差，走进评审现场</span>{preview&&<span class="preview-label">编辑预览 · AI 分析待复核</span>}</section>
  {featured ? <>
    <section class="news-lead-grid" aria-labelledby="lead-title">
      <article class="news-lead">
        <div class="news-kicker"><span>本期焦点</span><span>{categoryLabels[featured.category]} / {featured.topic}</span></div>
        <h1 id="lead-title"><a href={p(`/news/${featured.slug}/`)} data-news-link>{featured.headline}</a></h1>
        <p class="lead-deck">{featured.deck}</p>
        <div class="lead-original"><span>THE PAPER</span><p lang="en">{featured.title}</p></div>
        <div class="lead-bottom"><a class="read-feature" href={p(`/news/${featured.slug}/`)}>阅读完整分析 <span aria-hidden="true">↗</span></a><span>{featured.read_minutes} 分钟深读 · 公开材料观察</span></div>
      </article>
      <aside class="news-lead-aside" aria-label="焦点评分与阅读提示">
        <div class="lead-score-heading"><span>分数与结果</span><strong>{featured.decision}</strong></div>
        <ScorePlot article={featured} compact/>
        <div class="editor-note"><span class="small-caps">EDITOR'S NOTE</span><h2>均分不是最终决定。</h2><p>数字呈现分歧，论证解释分歧。沿着论文、评审、作者回复与公开决定，分清每一种声音。</p><a href={p('/methodology/')}>我们的阅读方法 <span aria-hidden="true">→</span></a></div>
      </aside>
    </section>
    <section class="issue-ticker" aria-label="本期内容概况"><span class="ticker-title">本期深读</span><span><b>{articles.length}</b> 篇案例</span><span>低分录取 <b>{lowCount}</b></span><span>高分拒稿 <b>{highCount}</b></span><span class="ticker-note">基于公开材料 · 逐篇列出来源</span></section>
    {articles.length>0&&<div class="news-archive-note"><span>材料说明</span><p>本期为 {articles.length} 篇案例专题，非全会议排名。评审取自 2026-05-08 公开存档。ICLR 2026 评分曾回退至 rebuttal 前，应结合作者回复和 AC 意见理解。<a href="https://blog.iclr.cc/2026/03/31/a-retrospective-on-the-iclr-2026-review-process/" target="_blank" rel="noopener noreferrer">阅读会议官方回顾 ↗</a></p></div>}
    {articles.length>1&&<section class="news-collection" aria-labelledby="collection-title"><div class="editorial-section-title"><h2 id="collection-title">更多案例<span>THE CASES</span></h2><span>不止于分数，逐篇看证据。</span></div><div class="news-card-grid">{articles.slice(1).map((article,index)=><NewsCard article={article} index={index+2}/>)}</div></section>}
  </> : <section class="news-preparing"><div class="news-kicker"><span>公开评审 · 深度阅读</span></div><h1>分数之外，<br/>重新读懂一场评审。</h1><p>从低分录取与高分拒稿出发，回到论文、评审意见和作者回复。我们关注结论如何形成，也记录证据尚不能回答的问题。</p><div class="preparing-note"><span class="small-caps">IN THE NEWSROOM</span><h2>本期案例正在整理</h2><p>文章完成来源核对与人工复核后，将在这里呈现。当前尚无可公开的案例分析。</p></div></section>}

  <div class="news-reading-note"><span>阅读提示</span><p>评分反差本身不构成错评证据。公开事实、评审意见、作者主张与 AI 分析在文中分别标明；材料不足时，保留判断。</p></div>
  <section class="archive-entrances" aria-label="论文榜单"><div class="editorial-section-title"><h2>回到数据<span>THE RECORD</span></h2><a href={p('/data-status/')}>覆盖范围与数据状态 ↗</a></div><div class="archive-grid"><a class="archive-link" href={p('/iclr-2026/low-score-accepted/')}><span class="archive-number">01 / ACCEPTED</span><div><h2>低分录取</h2><p>查看公开评分、录用决定与逐篇来源。</p></div><span class="archive-arrow" aria-hidden="true">↗</span></a><a class="archive-link" href={p('/iclr-2026/high-score-rejected/')}><span class="archive-number">02 / REJECTED</span><div><h2>高分拒稿</h2><p>查看公开评分、拒稿决定与逐篇来源。</p></div><span class="archive-arrow" aria-hidden="true">↗</span></a></div></section>
</Base>
