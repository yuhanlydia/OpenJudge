---
import Base from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import {loadNewsroom,deskLabels} from '../lib/newsroom';
import {sitePath} from '../lib/basepath';
const articles=loadNewsroom();
const publicEdition=process.env.NEWSROOM_PUBLIC==='1';
const preview=process.env.NEWSROOM_PREVIEW==='1';
const p=(url:string)=>sitePath(url,import.meta.env.BASE_URL);
const desks=[
 {id:'serious-errors' as const,number:'01',caption:'数字、公式或记录存在可定位的冲突。逐项说明谁错在哪里，以及错误能影响什么。'},
 {id:'low-accepted' as const,number:'02',caption:'本期录取案例的归档均分为 2.50–4.67。看 AC 为什么仍然认可贡献，哪些低分意见有依据。'},
 {id:'high-rejected' as const,number:'03',caption:'本板块案例的归档均分为 6.50–6.80。看高分是否回应了关键缺陷，AC 的拒稿理由能否成立。'},
];
---
<Base active="overview">
 <section class="edition-intro" id="cases"><span class="small-caps">ICLR 2026 / 公开评审观察</span><h1>先看分数和结果，再判断谁说得对。</h1><p>每篇先讲清论文的 gap、方法与效果，再逐位核查 reviewer、AC 和作者回复。</p>{preview&&<span class="preview-label">编辑预览 · AI 分析待复核</span>}</section>
 {articles.length>0?<>
 <nav class="desk-navigation" aria-label="三个案例板块">{desks.map(d=><a href={`#${d.id}`}><span>{d.number}</span><strong>{deskLabels[d.id]}</strong><b>{articles.filter(a=>(a.desk||a.category)===d.id).length} 篇</b></a>)}</nav>
 <p class="edition-scope">本期 {articles.length} 篇选题，每篇只归入一个板块。有明确矛盾的案例优先放入第一个板块；其余按评分与结果分类。低分、高分是本期选题范围，非全会议排名。</p>
 {desks.map(d=><section class="news-collection desk-collection" id={d.id} aria-labelledby={`title-${d.id}`} data-desk={d.id}><div class="desk-heading"><span>{d.number}</span><div><h2 id={`title-${d.id}`}>{deskLabels[d.id]}</h2><p>{d.caption}</p></div></div><div class="news-card-grid">{articles.filter(a=>(a.desk||a.category)===d.id).map(article=><NewsCard article={article} index={articles.indexOf(article)+1}/>)}</div></section>)}
 {publicEdition&&<p class="revision-note"><strong>2026.09.28 阅读结构更新</strong> · 十篇新增论文三段式、核心贡献和逐位评审核查。<a href={p('/contribute/#updates')}>查看修订记录 →</a></p>}
 <div class="news-archive-note"><span>分数口径</span><p>使用 2026-05-08 公开存档。ICLR 2026 曾将分数恢复至 rebuttal 前，不能把图示分数当作最终共识。<a href="https://blog.iclr.cc/2026/03/31/a-retrospective-on-the-iclr-2026-review-process/" target="_blank" rel="noopener noreferrer">会议官方回顾 ↗</a></p></div>
 </>:<section class="news-preparing"><h2>本期案例正在整理</h2><p>当前尚无可公开的案例分析。</p></section>}
 <div class="news-reading-note"><span>判断依据</span><p>分数反差不自动构成错评，数据矛盾也不自动证明编造。每一项判断都列出证据和范围；本站为 AI 辅助分析，未完成独立实验复现。</p></div>
 {!publicEdition&&<section class="archive-entrances" aria-label="论文榜单"><div class="archive-grid"><a class="archive-link" href={p('/iclr-2026/low-score-accepted/')}><h2>低分录取</h2></a><a class="archive-link" href={p('/iclr-2026/high-score-rejected/')}><h2>高分拒稿</h2></a></div></section>}
</Base>
