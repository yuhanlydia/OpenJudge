---
import Base from '../layouts/BaseLayout.astro';import CaseRow from './CaseRow.astro';import EmptyState from './EmptyState.astro';import Notice from './ProcessNotice.astro';import {loadPublicSnapshot,ranked} from '../lib/data';import {sitePath} from '../lib/basepath';
const {kind}=Astro.props;const low=kind==='low-score-accepted';const s=loadPublicSnapshot(),items=ranked(s,low?'low_score_accepted':'high_score_rejected');const p=(url:string)=>sitePath(url,import.meta.env.BASE_URL);const title=low?'低分录取':'高分拒稿';
---
<Base active="boards" title={`${title} · ReviewCase`}><div class="breadcrumb"><a href={p('/')}>概览</a><span>/</span><span>ICLR 2026</span></div><div class="page-top"><div><div class="eyebrow">ICLR 2026 · {low?'ACCEPTED':'REJECTED'}</div><h1>{title}</h1><p>当前已取得材料中的排行。按均分{low?'升':'降'}序排列；同分以论文 ID 稳定排序，不表示争议程度。</p></div><div class="edition"><b>≥ 3</b>有效评分 / 论文</div></div><div class="subnav"><a class:list={[low&&'active']} href={p('/iclr-2026/low-score-accepted/')}>低分录取</a><a class:list={[!low&&'active']} href={p('/iclr-2026/high-score-rejected/')}>高分拒稿</a></div><form class="filters" id="filters"><div class="field search"><label for="q">关键词</label><input id="q" name="q" type="search" placeholder="搜索论文标题或关键词"/></div><div class="field"><label for="minMean">最低均分</label><input id="minMean" name="minMean" type="number" step="0.01" min="0" placeholder="不限"/></div><div class="field"><label for="maxMean">最高均分</label><input id="maxMean" name="maxMean" type="number" step="0.01" min="0" placeholder="不限"/></div><div class="field"><label for="minReviews">最少评审数</label><input id="minReviews" name="minReviews" type="number" min="3" value="3"/></div><div class="field"><label for="reportState">分析状态</label><select id="reportState" name="reportState"><option value="all">全部状态</option><option value="not_generated">尚未分析</option><option value="approved">已审核</option><option value="published">已发布</option><option value="stale">待复核</option></select></div><button class="button" type="submit">应用筛选</button><a class="button secondary" href={p(`/iclr-2026/${kind}/`)}>清除</a></form><div class="result-meta"><span data-result-count>{items.length} 篇符合条件</span><span>每页 25 篇 · 原始分数完整保留</span></div><section class:list={['board full-board',!low&&'amber']} data-board data-index={p(`/indexes/${kind}.json`)} data-base={p('/papers/')}><div class="column-head"><span>序号 / 论文 / 评审分数</span><span>均分</span></div><div data-results aria-live="polite">{items.length?items.slice(0,25).map((paper,i)=><CaseRow paper={paper} rank={i+1}/>):<EmptyState/>}</div></section><div class="pagination" data-pagination hidden={items.length<=25}><button class="button secondary" data-prev disabled>上一页</button><span data-page-label>1 / {Math.max(1,Math.ceil(items.length/25))}</span><button class="button secondary" data-next disabled={items.length<=25}>下一页</button></div><noscript><p class="meta">JavaScript 已关闭：当前显示首 25 条记录。筛选与翻页需要启用 JavaScript。</p></noscript><p class="meta" data-filter-error role="alert" hidden>筛选索引暂时无法加载，已保留首屏记录。请重新加载页面。</p><Notice/></Base>
<script>
import {filterCases,paginate,readFilter} from '../lib/filter';
const board=document.querySelector<HTMLElement>('[data-board]');
if(board){
 const form=document.querySelector<HTMLFormElement>('#filters')!;const results=document.querySelector<HTMLElement>('[data-results]')!;let papers:any[]=[];let loaded=false;let currentPage=1;
 const names=['q','minMean','maxMean','minReviews','reportState'];
 function restore(){const f=readFilter(new URLSearchParams(location.search));for(const name of names){const input=form.elements.namedItem(name) as HTMLInputElement|HTMLSelectElement;input.value=String((f as any)[name]??'');}currentPage=f.page||1;}
 function el(tag:string,cls:string,text=''){const node=document.createElement(tag);node.className=cls;node.textContent=text;return node;}
 function row(p:any,rank:number){const a=el('article','case-row');a.append(el('span','rank mono',String(rank).padStart(2,'0')));const center=el('div','');const link=el('a','case-title',p.title) as HTMLAnchorElement;link.href=board!.dataset.base+encodeURIComponent(p.forum_id)+'/';center.append(link);const meta=el('div','row-meta'),strip=el('div','score-strip');strip.setAttribute('aria-label','所有有效评审分数');for(const score of p.score_summary.scores)strip.append(el('span','score',String(score)));meta.append(strip,el('span','meta',p.score_summary.valid_review_count+' 份评审'),el('span','pill',({approved:'已审核',published:'已发布',stale:'待复核'} as any)[p.report_state]||'尚未分析'));center.append(meta);const mean=el('div','mean mono',p.score_summary.mean===null?'—':Number(p.score_summary.mean).toFixed(2));mean.append(el('small','','均分'));a.append(center,mean);return a;}
 function render(){const f=readFilter(new URLSearchParams(location.search));const filtered=filterCases(papers,f);const page=paginate(filtered,f.page);currentPage=page.page;results.replaceChildren();if(page.total){page.items.forEach((p,i)=>results.append(row(p,(page.page-1)*25+i+1)));}else{const box=el('div','empty');box.append(el('h3','',papers.length?'没有符合条件的论文':'尚未取得可验证的数据'),el('p','',papers.length?'请调整筛选条件，或清除筛选。':'完成真实数据导入后，这里才会出现论文排行。'));results.append(box);}document.querySelector('[data-result-count]')!.textContent=page.total+' 篇符合条件';const pager=document.querySelector<HTMLElement>('[data-pagination]')!;pager.hidden=page.pages<=1;document.querySelector('[data-page-label]')!.textContent=page.page+' / '+page.pages;(document.querySelector('[data-prev]') as HTMLButtonElement).disabled=page.page<=1;(document.querySelector('[data-next]') as HTMLButtonElement).disabled=page.page>=page.pages;if(f.page!==page.page){const params=new URLSearchParams(location.search);params.set('page',String(page.page));history.replaceState(null,'','?'+params);}}
 async function ensure(){if(!loaded){const response=await fetch(board!.dataset.index!);if(!response.ok)throw new Error('index unavailable');papers=await response.json();loaded=true;}}
 async function update(){try{await ensure();render();}catch{document.querySelector<HTMLElement>('[data-filter-error]')!.hidden=false;}}
 function setPage(page:number){const params=new URLSearchParams(location.search);params.set('page',String(page));history.pushState(null,'','?'+params);void update();}
 form.addEventListener('submit',event=>{event.preventDefault();const params=new URLSearchParams();for(const name of names){const val=(form.elements.namedItem(name) as HTMLInputElement).value;if(val)params.set(name,val);}history.pushState(null,'','?'+params);void update();});
 document.querySelector('[data-prev]')!.addEventListener('click',()=>setPage(currentPage-1));document.querySelector('[data-next]')!.addEventListener('click',()=>setPage(currentPage+1));addEventListener('popstate',()=>{restore();void update();});restore();if(location.search)void update();
}
</script>
