---
import Base from '../layouts/BaseLayout.astro';import Notice from './ProcessNotice.astro';import {sitePath,safeSource} from '../lib/basepath';import {fmt,date,reportLabel} from '../lib/data';
const {paper:p,historical=false,releaseId=''}=Astro.props;const site=(url:string)=>sitePath(url,import.meta.env.BASE_URL);const reviews=p.reviews||[];const report=p.report_state!=='stale'&&p.report&&['approved','published'].includes(p.report.editorial_state)?p.report:null;const published=!!report;
---
<Base active="boards" title={`${p.title} · ReviewCase`}><div class="breadcrumb"><a href={site('/')}>概览</a><span>/</span><a href={site(historical?'/versions/'+releaseId+'/':'/iclr-2026/low-score-accepted/')}>{historical?releaseId:'ICLR 2026'}</a><span>/</span><span>论文详情</span></div>{historical&&<div class="notice">历史快照，不代表当前状态。评分、来源和报告均来自 {releaseId}。</div>}{p.is_fixture&&<div class="notice">工程测试夹具 — 以下论文、评分与报告为虚构测试材料，不是真实 ICLR 论文。</div>}<div class="eyebrow">ICLR 2026 · PAPER RECORD</div><h1 class="detail-title">{p.title}</h1><div class="row-meta"><span class:list={['pill',p.decision==='Accept'?'pill-cyan':'pill-amber']}>{p.decision}</span><span class="pill">{reportLabel(p.report_state)}</span>{safeSource(p.source_url)&&<a class="text-link small" href={safeSource(p.source_url)!} target="_blank" rel="noopener noreferrer">OpenReview 原始页面 ↗</a>}</div><div class="detail-facts"><div class="mean mono">{fmt(p.score_summary.mean)}<small>有效评分均分</small></div><div><div class="score-strip" aria-label="所有原始有效分数">{p.score_summary.scores.map((n:any)=><span class="score">{n}</span>)}</div><div class="meta">{p.score_summary.valid_review_count} 份有效评分 · {p.score_summary.missing_rating_count||0} 份缺失 / 非法</div></div><div class="meta">材料抓取时间（上海）<br/>{date(p.observed_at)}</div></div><Notice/><div class="subnav" style="margin-top:28px"><a href="#scores">评分与来源</a><a href="#analysis">GPT 分析</a><a href="#writing">写作诊断</a><a href="#timeline">讨论时间线</a></div><div class="content-grid"><div><section id="scores" class="panel section-anchor"><h2>评分与来源</h2><p class="meta">当前公开快照评分；未自动认定为 rebuttal 后的最终评分。</p>{reviews.map((r:any,i:number)=><div><h3>评审 {i+1} <span class="pill">评分 {r.rating_value??'缺失'}</span></h3><p class="source-id">{r.review_id} · {r.source_hash?.slice(0,16)}…</p>{safeSource(p.source_url)&&<a class="text-link small" href={`https://openreview.net/forum?id=${encodeURIComponent(p.forum_id)}&noteId=${encodeURIComponent(r.review_id)}`} target="_blank" rel="noopener noreferrer">定位公开评审 ↗</a>}<details><summary>展开公开评审内容</summary>{Object.entries(r.content_fields||{}).map(([key,value])=><div class="review-text"><strong>{key}</strong><br/>{String(value)}</div>)}</details></div>)}{!reviews.length&&<p>没有可展示的公开评审。</p>}</section><section id="analysis" class="panel section-anchor"><h2>GPT 分析</h2>{p.report_state==='stale'?<div class="notice">证据已变化，先前报告待复核。当前材料不沿用旧结论。</div>:!published?<p class="meta">尚未分析。此页只展示已经取得的公开记录。</p>:<><p class="meta">模型：{report.model_reported||'未独立核验'} · 来源：{report.model_provenance||'unknown'} · 生成：{date(report.generated_at)}</p><p class="meta">人工审批：{report.reviewer_of_report} · {date(report.approved_at)}</p>{report.claims.map((claim:any)=><section><h3>{claim.claim_id} <span class="pill">{claim.claim_status}</span></h3><div class="report-evidence"><blockquote>{claim.quote||claim.review_quote||'未提供原文摘录'}</blockquote><div class="review-text">{claim.explanation||''}</div></div>{claim.limitations&&<p class="meta">限制：{claim.limitations}</p>}<details><summary>查看引用证据</summary>{[...(claim.supporting_evidence_ids||[]),...(claim.counter_evidence_ids||[])].map((id:string)=>{const e=(p.evidence||report.evidence||[]).find((x:any)=>x.evidence_id===id);return <div class="review-text"><strong>{id}</strong><p>{e?.quote||'请查阅对应证据包中的精确引用'}</p>{safeSource(e?.source_url)&&<a class="text-link" href={safeSource(e.source_url)!} target="_blank" rel="noopener noreferrer">原始来源 ↗</a>}</div>})}</details></section>)}</>}</section><section id="writing" class="panel section-anchor"><h2>写作诊断</h2>{published?<div class="review-text">{typeof report.writing_diagnosis==='string'?report.writing_diagnosis:JSON.stringify(report.writing_diagnosis||[],null,2)}</div>:<p class="meta">尚未分析。未生成论文改写或评审表达诊断。</p>}</section><section class="panel"><h2>公开决定依据</h2><p class="meta">决定来源：{p.decision_source_kind||'unknown'} · {p.decision_source_id||'未取得'}</p>{(p.discussion||[]).filter((d:any)=>d.note_id===p.decision_source_id||d.invitation?.some((i:string)=>i.endsWith('/-/Meta_Review'))).map((d:any)=><div class="review-text">{Object.entries(d.content_fields||{}).map(([k,v])=><p><strong>{k}</strong><br/>{String(v)}</p>)}</div>)}{published&&<div class="review-text">{report.decision_explanation||''}</div>}</section><section id="timeline" class="panel section-anchor"><h2>讨论时间线</h2>{(p.discussion||[]).length?<ol class="timeline">{p.discussion.map((d:any)=><li><time>{date(d.created_at||d.modified_at)}</time><h3>公开讨论记录</h3><p class="source-id">{d.note_id} · 回复 {d.replyto||'未记录'}</p><details><summary>展开内容</summary>{Object.entries(d.content_fields||{}).map(([k,v])=><div class="review-text"><strong>{k}</strong><br/>{String(v)}</div>)}</details></li>)}</ol>:<p class="meta">未取得可展示的讨论记录；不据此认定不存在讨论。</p>}</section></div><aside><section class="panel side-panel"><h2>材料完整性</h2><dl><dt>原始投稿版本</dt><dd>{p.coverage?.original_available?'已取得':'未取得可核验原稿'}</dd><dt>评分量表</dt><dd>{p.score_summary.scale_id||'尚未确认'}</dd><dt>快照标识</dt><dd>{p.snapshot_id||'未记录'}</dd><dt>分数总体标准差</dt><dd>{fmt(p.score_summary.std_population)}</dd><dt>当前材料的限制</dt><dd>论文版本角色未确认时，不使用当前版本证明原稿已包含某项内容。</dd></dl>{p.paper_versions?.map((v:any)=><p class="meta">版本：{v.version_role}<br/>来源：{v.version_id}<br/>时间：{date(v.available_at)}</p>)}</section>{p.issues?.length>0&&<section class="panel"><h2>记录说明</h2>{p.issues.map((i:any)=><p class="meta">{String(i)}</p>)}</section>}<a class="button secondary" href={site('/contribute/')}>补充证据 / 纠错</a></aside></div></Base>
